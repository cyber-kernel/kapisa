<article class="section page-width narrow-content"><p class="eyebrow">{{ article.published_at | date:"%d %B %Y" }}</p><h1>{{ article.title }}</h1>{% if article.image %}{{ article.image | image_url: width:1800 | image_tag: widths:'800,1200,1600,1800', sizes:'100vw', loading:'eager', alt:article.image.alt | default:article.title }}{% endif %}<div class="rte article-content">{{ article.content }}</div></article>
{% schema %}{"name":"Article","settings":[]} {% endschema %}