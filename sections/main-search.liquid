<section class="section page-width"><header class="collection-header"><p class="eyebrow">SEARCH</p><h1>{{ search.terms | escape }}</h1></header><form action="{{ routes.search_url }}" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search Kapisa" aria-label="Search"><button class="button" type="submit">Search</button></form>{% if search.performed %}{% if search.results_count > 0 %}<div class="product-grid product-grid--4">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product:item, show_swatches:true %}{% else %}<article class="search-result"><a href="{{ item.url }}">{{ item.title }}</a></article>{% endif %}{% endfor %}</div>{% else %}<div class="empty-note">No results found. Try another search.</div>{% endif %}{% endif %}</section>
{% schema %}{"name":"Search results","settings":[]} {% endschema %}