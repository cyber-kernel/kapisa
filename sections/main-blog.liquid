<section class="section page-width"><header class="collection-header"><p class="eyebrow">JOURNAL</p><h1>{{ blog.title }}</h1></header><div class="blog-grid">{% for article in blog.articles %}<article><a href="{{ article.url }}">{% if article.image %}{{ article.image | image_url: width:900 | image_tag: widths:'400,600,900', loading:'lazy', alt:article.image.alt | default:article.title }}{% endif %}<p class="eyebrow">{{ article.published_at | date:"%d %B %Y" }}</p><h2>{{ article.title }}</h2><p>{{ article.excerpt_or_content | strip_html | truncate:140 }}</p></a></article>{% endfor %}</div></section>
{% schema %}{"name":"Blog","settings":[]} {% endschema %}