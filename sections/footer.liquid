<footer class="site-footer" style="--footer-bg: {{ section.settings.background_color }}; --footer-text: {{ section.settings.text_color }};">
  {% if section.settings.show_newsletter %}
    <div class="page-width footer-newsletter">
      <div><p class="eyebrow">{{ section.settings.newsletter_eyebrow }}</p><h2>{{ section.settings.newsletter_heading }}</h2></div>
      {% form 'customer', class: 'footer-newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterEmail">Email address</label>
        <input id="FooterEmail" type="email" name="contact[email]" placeholder="Enter email address" required>
        <button class="button" type="submit">{{ section.settings.newsletter_button }}</button>
      {% endform %}
    </div>
  {% endif %}
  <div class="page-width footer-grid">
    <div class="footer-brand">
      {% if settings.logo != blank %}{{ settings.logo | image_url: width: 220 | image_tag: widths: '140,220', loading: 'lazy', alt: shop.name }}{% else %}<div class="footer-wordmark">{{ shop.name | default: 'KAPISA' }}</div>{% endif %}
      <h2>{{ section.settings.company_name }}</h2><p>{{ section.settings.description }}</p>
      <div class="footer-social">{% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}" aria-label="Instagram">Instagram</a>{% endif %}{% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}" aria-label="Facebook">Facebook</a>{% endif %}{% if section.settings.linkedin != blank %}<a href="{{ section.settings.linkedin }}" aria-label="LinkedIn">LinkedIn</a>{% endif %}</div>
    </div>
    {% for block in section.blocks %}<div class="footer-column" {{ block.shopify_attributes }}><h3>{{ block.settings.heading }}</h3>{% if block.settings.menu != blank %}<ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endfor %}
    <div class="footer-column footer-help"><h3>{{ section.settings.help_heading }}</h3><a class="footer-help-button" href="{{ section.settings.contact_link | default: routes.contact_url }}">{{ section.settings.contact_label }}</a>{% if section.settings.returns_link != blank %}<a class="footer-help-button footer-help-button--outline" href="{{ section.settings.returns_link }}">{{ section.settings.returns_label }}</a>{% endif %}</div>
  </div>
  <div class="page-width footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_text }}</span><div>{% if shop.policies.privacy_policy %}<a href="{{ shop.policies.privacy_policy.url }}">Privacy</a>{% endif %}{% if shop.policies.terms_of_service %}<a href="{{ shop.policies.terms_of_service.url }}">Terms</a>{% endif %}{% if shop.policies.refund_policy %}<a href="{{ shop.policies.refund_policy.url }}">Returns</a>{% endif %}</div></div>
</footer>
{% schema %}
{"name":"Kapisa footer","settings":[{"type":"color","id":"background_color","label":"Background color","default":"#49308D"},{"type":"color","id":"text_color","label":"Text color","default":"#FFFFFF"},{"type":"checkbox","id":"show_newsletter","label":"Show newsletter signup","default":true},{"type":"text","id":"newsletter_eyebrow","label":"Newsletter eyebrow","default":"STAY IN THE LOOP"},{"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"Our emails are like our scrubs. Focused on you."},{"type":"text","id":"newsletter_button","label":"Newsletter button","default":"Subscribe"},{"type":"text","id":"company_name","label":"Company name","default":"Kapisa"},{"type":"textarea","id":"description","label":"Description","default":"Premium medical apparel designed for modern professionals."},{"type":"text","id":"help_heading","label":"Help heading","default":"Need help?"},{"type":"text","id":"contact_label","label":"Contact button label","default":"Contact us"},{"type":"url","id":"contact_link","label":"Contact link"},{"type":"text","id":"returns_label","label":"Returns button label","default":"Exchanges & returns"},{"type":"url","id":"returns_link","label":"Returns link"},{"type":"textarea","id":"copyright_text","label":"Copyright text","default":"All rights reserved."},{"type":"url","id":"instagram","label":"Instagram"},{"type":"url","id":"facebook","label":"Facebook"},{"type":"url","id":"linkedin","label":"LinkedIn"}],"blocks":[{"type":"menu","name":"Menu","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shop"},{"type":"link_list","id":"menu","label":"Menu"}]}],"max_blocks":5,"presets":[{"name":"Kapisa footer","blocks":[{"type":"menu","settings":{"heading":"Shop"}},{"type":"menu","settings":{"heading":"Company"}},{"type":"menu","settings":{"heading":"Community"}}]}]}
{% endschema %}
