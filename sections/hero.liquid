<section class="hero{% if section.settings.full_height %} hero--full{% endif %}" style="--hero-overlay:{{ section.settings.overlay_opacity | divided_by:100.0 }};">
  <div class="hero-media">
    {% if section.settings.video != blank %}
      {{ section.settings.video | video_tag: autoplay:section.settings.autoplay, loop:section.settings.loop, muted:true, controls:section.settings.controls, playsinline:true, image_size:'2000x', class:'hero-video' }}
    {% elsif section.settings.image != blank %}
      <picture>{% if section.settings.mobile_image != blank %}<source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width:1200 }}">{% endif %}{{ section.settings.image | image_url: width:2400 | image_tag: widths:'800,1200,1600,2000,2400', sizes:'100vw', loading:'eager', class:'hero-image', alt:section.settings.image.alt | escape }}</picture>
    {% else %}<div class="hero-placeholder"></div>{% endif %}
    {% if section.settings.overlay %}<div class="hero-overlay"></div>{% endif %}
  </div>
  <div class="page-width hero-content hero-content--{{ section.settings.position }}">
    <div class="hero-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1>{{ section.settings.heading }}</h1>{% endif %}
      {% if section.settings.text != blank %}<div class="hero-text rte">{{ section.settings.text }}</div>{% endif %}
      <div class="hero-buttons">
        {% render 'button', label:section.settings.button_label, url:section.settings.button_link, arrow:true %}
        {% render 'button', label:section.settings.secondary_label, url:section.settings.secondary_link, style:'secondary', arrow:true %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Kapisa hero","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"video","id":"video","label":"Video"},{"type":"checkbox","id":"autoplay","label":"Autoplay video","default":true},{"type":"checkbox","id":"loop","label":"Loop video","default":true},{"type":"checkbox","id":"controls","label":"Show video controls","default":false},{"type":"checkbox","id":"overlay","label":"Image overlay","default":true},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"unit":"%","default":25},{"type":"checkbox","id":"full_height","label":"Full viewport height","default":true},{"type":"select","id":"position","label":"Content position","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"KAPISA"},{"type":"text","id":"heading","label":"Heading","default":"Made for the work that matters."},{"type":"richtext","id":"text","label":"Text","default":"<p>Premium medical apparel designed for long shifts, demanding days and everyday comfort.</p>"},{"type":"text","id":"button_label","label":"Primary button","default":"Shop all scrubs"},{"type":"url","id":"button_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Shop women"},{"type":"url","id":"secondary_link","label":"Secondary link"}],"presets":[{"name":"Kapisa hero"}]}
{% endschema %}