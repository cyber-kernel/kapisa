<section class="section page-width cart-page"><h1>{{ 'sections.cart.title' | t }}</h1>{% if cart.item_count == 0 %}<div class="empty-cart"><p>Your cart is empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" id="cart-form"><div class="cart-items">{% for item in cart.items %}<div class="cart-item"><a href="{{ item.url }}">{{ item.image | image_url: width:300 | image_tag: widths:'120,200,300', loading:'lazy', alt:item.image.alt | default:item.product.title }}</a><div><a href="{{ item.url }}"><h2>{{ item.product.title }}</h2></a><p>{{ item.variant.title }}</p><div class="quantity"><button type="button" data-qty-minus>−</button><input name="updates[]" value="{{ item.quantity }}" min="0" type="number"><button type="button" data-qty-plus>+</button></div><p>{{ item.final_line_price | money }}</p><a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a></div></div>{% endfor %}</div><div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><button class="button" type="submit" name="checkout">Checkout</button><button class="button button--secondary" type="submit" name="update">Update cart</button></div></form>{% endif %}</section>
{% schema %}{"name":"Cart","settings":[]} {% endschema %}