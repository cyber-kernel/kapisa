<section class="product-page-shell">
  <div class="page-width">
    <nav class="product-breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span>/</span>
      {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>{% endif %}
      <strong>{{ product.title }}</strong>
    </nav>
    <div class="product-page">
      <div class="product-gallery">
        <div class="product-gallery-layout">
          {% if product.media.size > 1 %}
            <div class="product-thumbnails" aria-label="Product gallery">
              {% for media in product.media %}
                {% assign media_variant_ids = media.variants | map: 'id' | join: ',' %}
                <button type="button" class="product-thumbnail{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ media.id }}" data-media-variant-ids="{{ media_variant_ids }}" aria-label="View image {{ forloop.index }}">
                  {{ media.preview_image | image_url: width: 220 | image_tag: widths: '110,220', loading: 'lazy', alt: media.alt | default: product.title }}
                </button>
              {% endfor %}
            </div>
          {% endif %}
          <div class="product-media-grid">
            {% for media in product.media %}
              {% assign media_variant_ids = media.variants | map: 'id' | join: ',' %}
              <div class="product-media" data-gallery-media="{{ media.id }}" data-media-variant-ids="{{ media_variant_ids }}">
                {% case media.media_type %}
                  {% when 'image' %}{{ media | image_url: width: 1600 | image_tag: widths: '600,900,1200,1600', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', alt: media.alt | default: product.title }}
                  {% when 'video' %}{{ media | video_tag: controls: true, playsinline: true, preload: 'metadata' }}
                  {% when 'external_video' %}{{ media | external_video_tag }}
                  {% when 'model' %}{{ media | model_viewer_tag }}
                {% endcase %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="product-info">
        <div class="product-info-topline">
          {% if section.settings.show_vendor and product.vendor != blank %}<p class="eyebrow">{{ product.vendor }}</p>{% endif %}
          {% if section.settings.badge != blank %}<span class="product-detail-badge">{{ section.settings.badge }}</span>{% endif %}
        </div>
        <div class="product-title-row">
          <h1>{{ product.title }}</h1>
          <button type="button" class="product-share" data-product-share aria-label="Share product">↗</button>
        </div>
        {% if section.settings.show_rating %}
          <div class="product-rating" aria-label="{{ section.settings.rating }} out of 5 stars"><span>★★★★★</span><strong>{{ section.settings.rating }}</strong>{% if section.settings.review_label != blank %}<a href="#ProductReviews">({{ section.settings.review_label }})</a>{% endif %}</div>
        {% endif %}
        <div class="product-meta-pills" aria-label="Product care essentials">
          <span>4-way stretch</span>
          <span>Medical grade</span>
          <span>Easy care</span>
        </div>
        <div class="product-info-price">{% render 'price', product: product %}<span class="product-tax-note">{{ section.settings.tax_note }}</span></div>
        {% if section.settings.emi_text != blank %}<div class="product-emi">{{ section.settings.emi_text }}</div>{% endif %}
        {% if section.settings.show_description %}<div class="product-description rte">{{ product.description }}</div>{% endif %}
        {% form 'product', product, id: 'product-form', class: 'product-form', novalidate: true %}
          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {% assign option_name = option.name | downcase %}
              <fieldset class="product-option">
                <legend>{{ option.name }}: <strong data-selected-option="{{ option.name | handleize }}">{{ option.selected_value }}</strong>{% if section.settings.size_guide != blank and option_name contains 'size' %}<a href="#SizeGuide">{{ section.settings.size_guide_label }}</a>{% endif %}</legend>
                <div class="variant-values">
                  {% for value in option.values %}
                    <label class="variant-value{% if option_name contains 'color' or option_name contains 'colour' %} variant-value--color{% endif %}">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                      <span{% if option_name contains 'color' or option_name contains 'colour' %} class="color-swatch color-swatch--{{ value | handleize }}"{% endif %} title="{{ value }}">{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          {% endunless %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <script type="application/json" data-variant-json>{{ product.variants | json }}</script>
          <label class="quantity-label" for="Quantity-{{ section.id }}">Quantity</label>
          <div class="quantity"><button type="button" data-qty-minus aria-label="Decrease quantity">−</button><input id="Quantity-{{ section.id }}" name="quantity" type="number" value="1" min="1"><button type="button" data-qty-plus aria-label="Increase quantity">+</button></div>
          <button type="submit" name="add" class="button product-submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to bag{% else %}Sold out{% endif %}</button>
          {{ form | payment_button }}
          <div class="product-form-message" data-product-form-message></div>
        {% endform %}
        <div class="product-promises">
          {% if section.settings.promise_one != blank %}<span>✓ {{ section.settings.promise_one }}</span>{% endif %}
          {% if section.settings.promise_two != blank %}<span>✓ {{ section.settings.promise_two }}</span>{% endif %}
          {% if section.settings.promise_three != blank %}<span>✓ {{ section.settings.promise_three }}</span>{% endif %}
        </div>
        <div class="accordion-list" id="SizeGuide">
          {% if section.settings.shipping_text != blank %}<details open><summary>Shipping & returns</summary><div class="rte">{{ section.settings.shipping_text }}</div></details>{% endif %}
          {% if section.settings.care_text != blank %}<details><summary>Care & fabric</summary><div class="rte">{{ section.settings.care_text }}</div></details>{% endif %}
          {% if section.settings.size_guide != blank %}<details><summary>{{ section.settings.size_guide_label }}</summary><div class="rte">{{ section.settings.size_guide }}</div></details>{% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var share = document.querySelector('[data-product-share]');
    if (share) share.addEventListener('click', function () {
      if (navigator.share) navigator.share({ title: document.title, url: window.location.href });
      else if (navigator.clipboard) navigator.clipboard.writeText(window.location.href).then(function () { share.textContent = '✓'; });
    });
  });
</script>
{% schema %}
{"name":"Main product","settings":[{"type":"checkbox","id":"show_vendor","label":"Show vendor","default":false},{"type":"checkbox","id":"show_rating","label":"Show rating","default":true},{"type":"text","id":"rating","label":"Rating","default":"4.9"},{"type":"text","id":"review_label","label":"Review label","default":"Reviews"},{"type":"text","id":"badge","label":"Product badge","default":"Best seller"},{"type":"checkbox","id":"show_description","label":"Show description","default":true},{"type":"text","id":"tax_note","label":"Tax note","default":"Inclusive of all taxes"},{"type":"text","id":"emi_text","label":"Payment / EMI message","default":"Easy payments available at checkout"},{"type":"text","id":"promise_one","label":"Promise one","default":"Free shipping over ₹1,999"},{"type":"text","id":"promise_two","label":"Promise two","default":"Easy 7-day returns"},{"type":"text","id":"promise_three","label":"Promise three","default":"Secure checkout"},{"type":"text","id":"size_guide_label","label":"Size guide label","default":"Size guide"},{"type":"richtext","id":"size_guide","label":"Size guide content"},{"type":"richtext","id":"shipping_text","label":"Shipping and returns","default":"<p>Dispatches in 1–2 business days. Easy returns within 7 days.</p>"},{"type":"richtext","id":"care_text","label":"Care and fabric","default":"<p>Machine wash cold with similar colors. Do not bleach.</p>"}],"presets":[{"name":"Main product"}]}
{% endschema %}
