<section class="section page-width">
  <div class="section-heading text-center"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="testimonial-grid">
    {% for block in section.blocks %}
      <blockquote class="testimonial" {{ block.shopify_attributes }}>
        <div class="stars" aria-label="{{ block.settings.rating }} out of 5">{% for i in (1..5) %}★{% endfor %}</div>
        <p>"{{ block.settings.quote }}"</p>
        <footer><strong>{{ block.settings.name }}</strong>{% if block.settings.role != blank %}<span>{{ block.settings.role }}</span>{% endif %}</footer>
      </blockquote>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Testimonials","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WORN BY PEOPLE WHO CARE"},{"type":"text","id":"heading","label":"Heading","default":"What our community says"}],"blocks":[{"type":"testimonial","name":"Testimonial","settings":[{"type":"textarea","id":"quote","label":"Review","default":"Add a real customer review here."},{"type":"text","id":"name","label":"Name","default":"Customer name"},{"type":"text","id":"role","label":"Profession"},{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5}]}],"max_blocks":6,"presets":[{"name":"Testimonials","blocks":[{"type":"testimonial"},{"type":"testimonial"},{"type":"testimonial"}]}]}
{% endschema %}