<section class="section why-section">
  <div class="page-width"><div class="section-heading text-center"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="features-grid">
    {% for block in section.blocks %}
      <div class="feature-item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width:160 | image_tag: widths:'80,120,160', loading:'lazy', alt:block.settings.heading }}{% elsif block.settings.icon != blank %}<div class="feature-icon">{{ block.settings.icon }}</div>{% else %}<div class="feature-number">0{{ forloop.index }}</div>{% endif %}
        <h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div></div>
</section>
{% schema %}
{"name":"Why Kapisa","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"WHY KAPISA"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtful by design."}],"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"image_picker","id":"image","label":"Icon image"},{"type":"textarea","id":"icon","label":"Custom SVG / icon markup"},{"type":"text","id":"heading","label":"Heading","default":"Purposeful design"},{"type":"textarea","id":"text","label":"Text","default":"Considered details for the way modern healthcare professionals move and work."}]}],"max_blocks":6,"presets":[{"name":"Why Kapisa","blocks":[{"type":"feature","settings":{"heading":"Purposeful design"}},{"type":"feature","settings":{"heading":"All-day comfort"}},{"type":"feature","settings":{"heading":"Functional details"}},{"type":"feature","settings":{"heading":"Built to last"}}]}]}
{% endschema %}