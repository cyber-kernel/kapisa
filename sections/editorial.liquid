<section class="section page-width">
  <div class="editorial editorial--{{ section.settings.layout }}">
    <div class="editorial-media">
      {% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay:true, loop:true, muted:true, playsinline:true, image_size:'1400x' }}{% elsif section.settings.image != blank %}{{ section.settings.image | image_url: width:1600 | image_tag: widths:'600,900,1200,1600', sizes:'(min-width:990px) 55vw, 100vw', loading:'lazy', alt:section.settings.image.alt | default:section.settings.heading }}{% else %}<div class="media-placeholder"></div>{% endif %}
    </div>
    <div class="editorial-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {% render 'button', label:section.settings.button_label, url:section.settings.link, arrow:true %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Editorial story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"video","id":"video","label":"Video"},{"type":"select","id":"layout","label":"Layout","options":[{"value":"image-left","label":"Image left"},{"value":"image-right","label":"Image right"}],"default":"image-left"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE KAPISA STANDARD"},{"type":"text","id":"heading","label":"Heading","default":"Designed for the people who show up."},{"type":"richtext","id":"text","label":"Text","default":"<p>Long shifts, early mornings and demanding days deserve apparel that feels considered from the first hour to the last.</p>"},{"type":"text","id":"button_label","label":"Button","default":"Discover Kapisa"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Editorial story"}]}
{% endschema %}