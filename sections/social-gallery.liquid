<section class="section page-width">
  <div class="section-heading split-heading"><div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>{% if section.settings.link_label != blank %}{% render 'button', label:section.settings.link_label, url:section.settings.link, style:'secondary' %}{% endif %}</div>
  <div class="social-grid social-grid--{{ section.blocks.size }}">
    {% for block in section.blocks %}<a href="{{ block.settings.link | default:'#' }}" class="social-item" {{ block.shopify_attributes }}>{% if block.settings.image != blank %}{{ block.settings.image | image_url: width:800 | image_tag: widths:'300,500,800', sizes:'(min-width:990px) 16vw, 33vw', loading:'lazy', alt:block.settings.alt }}{% endif %}<span class="social-hover">View</span></a>{% endfor %}
  </div>
</section>
{% schema %}
{"name":"Social gallery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"@KAPISA_SCRUB"},{"type":"text","id":"heading","label":"Heading","default":"The Kapisa world"},{"type":"text","id":"link_label","label":"Link label","default":"Follow us"},{"type":"url","id":"link","label":"Instagram link"}],"blocks":[{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Alt text"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":6,"presets":[{"name":"Social gallery","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]}
{% endschema %}