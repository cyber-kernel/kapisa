{% if section.settings.enabled %}
<div class="announcement-bar announcement-bar--{{ section.settings.animation }}" data-announcement style="--announcement-speed: {{ section.settings.speed }}s;">
  <div class="page-width announcement-inner">
    {% for block in section.blocks %}
      <div class="announcement-message{% if forloop.first %} is-active{% endif %}" data-announcement-item {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{% else %}<span>{{ block.settings.text }}</span>{% endif %}
      </div>
    {% endfor %}
    {% if section.settings.dismissible %}<button class="announcement-close" type="button" aria-label="Close announcement" data-announcement-close>&times;</button>{% endif %}
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded',()=>{const b=document.querySelector('[data-announcement]');if(!b)return;const items=[...b.querySelectorAll('[data-announcement-item]')];if(!items.length)return;{% if section.settings.dismissible %}if(sessionStorage.getItem('kapisa-announcement')==='1')b.hidden=true;const c=b.querySelector('[data-announcement-close]');if(c)c.onclick=()=>{sessionStorage.setItem('kapisa-announcement','1');b.hidden=true};{% endif %}{% if section.settings.autoplay %}let i=0;setInterval(()=>{items[i].classList.remove('is-active');i=(i+1)%items.length;items[i].classList.add('is-active')},{{ section.settings.speed | times: 1000 }});{% endif %}});
</script>
{% endif %}
{% schema %}
{"name":"Announcement bar","settings":[{"type":"checkbox","id":"enabled","label":"Enable","default":true},{"type":"checkbox","id":"dismissible","label":"Allow dismissal","default":false},{"type":"checkbox","id":"autoplay","label":"Rotate announcements","default":false},{"type":"select","id":"animation","label":"Animation","options":[{"value":"none","label":"None"},{"value":"fade","label":"Fade"},{"value":"slide","label":"Slide"},{"value":"marquee","label":"Marquee"}],"default":"fade"},{"type":"range","id":"speed","label":"Animation / rotation speed","min":3,"max":12,"step":1,"unit":"s","default":5}],"blocks":[{"type":"announcement","name":"Announcement","settings":[{"type":"text","id":"text","label":"Text","default":"Introducing Kapisa — premium medical apparel"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":5,"presets":[{"name":"Announcement bar","blocks":[{"type":"announcement"}]}]}
{% endschema %}